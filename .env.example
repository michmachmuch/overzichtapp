# Copy this file to .env and fill it in. Never commit .env.

# Personal access token from https://gitlab.windesheim.nl/-/user_settings/personal_access_tokens
# Give it ONLY the read_api scope. The app never writes to GitLab.
GITLAB_TOKEN=

# The team project: its numeric id or its full path.
GITLAB_PROJECT=org.hbo-ict/se/oosdd/v26/groepen/oosddc2/v-ictoosdd_volleypool_project_studentversie

GITLAB_URL=https://gitlab.windesheim.nl

# Where tijdregistratie commits its time entries. Several branches: develop,feature/x
TIMETRACKING_BRANCH=develop
TIMETRACKING_DIR=.time-tracking

# Optional: the tijdregistratie userId to treat as yours. Normally detected from
# your GitLab id or from who made the commit.
# TIMETRACKING_USER_ID=

# Set to 1 to try the app with example data, without GitLab.
DEMO=0
